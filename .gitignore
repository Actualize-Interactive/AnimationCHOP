
dist
__pycache__
build
*.egg-info
.vscode
.vs
*.*.toe
# TouchDesigner's incremental saves, beside any project rather than only the
# root one. Their contents already match *.*.toe, but only because TD happens to
# name them that way.
Backup/
*.exp
*.obj
*.pdb
*.ilk
*.dmp
.DS_Store

# Local plugin build output. CMake copies the built libraries here post-build,
# and TouchDesigner writes a per-machine Plugins.json trust file alongside them.
# Released binaries are published as release assets instead.
td/Plugins/
tests/td/Plugins/

# Sentinel written by the in-TD integration run, consumed by run_td_tests.*
tests/td/results.json

# The pytest extension is copied next to its tests so `import animationchop`
# resolves; it is a build artifact.
tests/python/*.pyd
tests/python/*.so
.pytest_cache/
